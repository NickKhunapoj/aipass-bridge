# aipass-bridge (headless deployment)

# Password for the noVNC web desktop. Leave blank ONLY when noVNC stays bound to
# 127.0.0.1 (the default) and you reach it over an SSH tunnel. Set a strong value
# before exposing port 6080 to any network.
noVNC_PASSWORD=

# Required for a private API endpoint. Generate a value with:
#   openssl rand -hex 32
# Clients send it as: Authorization: Bearer <this value>
AIPASS_API_KEY=

# Concurrent API jobs per ready extension worker. Lower this if AiPASS starts
# throttling a single logged-in tab; additional healthy workers add capacity.
AIPASS_EXTENSION_CONCURRENCY=4

# Keep new requests queued across a short Chromium/extension reconnect. The
# extension heartbeat is considered stale after 45 seconds.
AIPASS_EXTENSION_WAIT_MS=20000
AIPASS_EXTENSION_STALE_MS=45000

# Optional: a webhook. Discord uses a modern rich status card automatically;
# Slack-compatible endpoints receive a concise text message. Leave blank to
# log locally only.
AIPASS_ALERT_WEBHOOK_URL=
# Set to 0 to keep Discord/Slack to warnings and alerts only. The default logs
# lifecycle and recovery info too, without sending a message on every poll.
AIPASS_ALERT_INCLUDE_INFO=1
# Alert repeats are suppressed for this many seconds while an incident remains.
AIPASS_ALERT_COOLDOWN_SECONDS=900
# Check every 30 seconds. A job is only treated as stuck after 16 minutes of
# silence, safely beyond the bridge's 15-minute video/media silence allowance.
AIPASS_WATCHDOG_INTERVAL_SECONDS=30
AIPASS_WATCHDOG_STUCK_JOB_MS=960000
